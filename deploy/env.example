# ---- PG / Redis（环境提供）----
# PG_HOST 建议填 RDS 内网域名（形如 xxxxxxxx.pg.rds.aliyuncs.com），FC 需接入 RDS 所在 VPC 才能连通
PG_HOST=xxxxxxxxxxxx.pg.rds.aliyuncs.com
PG_PORT=5432
PG_DB=cloudshuttle
PG_USER=cloudshuttle
PG_PASSWORD=***
# Redis：内网不带 TLS 用 redis://:密码@host:6379/0；公网带 TLS 用 rediss://:密码@host:6379
REDIS_URL=redis://:密码@xxxxxxxxxxxx.redis.rds.aliyuncs.com:6379/0
# ---- 凭证加密（国密 SM4，16 字节 hex = 32 个十六进制字符）----
# 仅当使用凭证库（审批机器人 / 私有仓库 / S3）时才必须配置
SM4_KEY=
# ---- 回调用绝对地址（可选）：留空则从触发请求 Host 自动推导 ----
CONTROL_BASE=
# ---- 阿里云（ECI / OSS 下发到 runner 的环境）----
ALIYUN_AK=***
ALIYUN_SK=***
ALIYUN_REGION=cn-hangzhou